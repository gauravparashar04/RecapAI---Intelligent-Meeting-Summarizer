# ── Mistral AI Configuration ─────────────────────────────────────────────────
# Get your API key from: https://console.mistral.ai/
MISTRAL_API_KEY=put your mistral.ai api key here

# ── Speech-to-Text: OpenAI Whisper (Local) ───────────────────────────────────
# Available models: tiny, base, small, medium, large (default: small)
WHISPER_MODEL=small

# ── Speech-to-Text: Sarvam AI (Hinglish/Indic Translation) ───────────────────
# Get your API key from: https://www.sarvam.ai/
SARVAM_API_KEY=put your srvam api key here
SARVAM_STT_MODEL=saaras:v2.5
