# =================================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE FOR RECAPAI EXPRESS SERVER
# =================================================================================

# Port where the Node.js/Express backend server listens
PORT=5000

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas Cloud string)
MONGO_URI=mongodb://127.0.0.1:27017/recapai

# Base URL of the Python FastAPI Microservice
PYTHON_AI_URL=http://127.0.0.1:8000
